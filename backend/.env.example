# Copy to .env. Never commit .env.
# Required to run a check.
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Optional. Without it the known fact-check lookup is skipped.
GOOGLE_FACTCHECK_API_KEY=

# SQLite by default. For PostgreSQL: postgresql+psycopg://user:password@localhost/claimtrace
DATABASE_URL=sqlite:///./claimtrace.db

# Optional. Without Redis, fact-check lookups are cached in memory.
# REDIS_URL=redis://localhost:6379/0
