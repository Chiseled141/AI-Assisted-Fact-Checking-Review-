# Copy to .env. Never commit .env.
# Models are in config/models.toml; limits and chart settings in app/core/config.py. Any of them can be overridden here by its upper-case name.
# Required to run a check.
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# SQLite in app/db/claimtrace.db by default. For PostgreSQL: postgresql+psycopg://user:password@localhost/claimtrace
# DATABASE_URL=
