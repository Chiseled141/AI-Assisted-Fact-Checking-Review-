# Copy to .env, in this folder. Never commit .env. The backend reads it.

# --- Backend -------------------------------------------------------------------------------------------------------
# Models are in backend/src/claimtrace/config/models.toml and backend/src/claimtrace/config/data/judges.json; limits and chart settings in
# backend/src/claimtrace/config/settings.py. Any setting can be overridden here by its upper-case name.
# Required to run a check.
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# PostgreSQL. This is the default, for a local role "claimtrace" with no password; see the README for setup.
# With a password: postgresql+psycopg://claimtrace:PASSWORD@localhost:5432/claimtrace
DATABASE_URL=postgresql+psycopg://claimtrace@localhost:5432/claimtrace

# Accounts. Turn this on when the site is served over HTTPS, so the session cookie is only sent encrypted.
# SESSION_COOKIE_SECURE=true

# --- Frontend ------------------------------------------------------------------------------------------------------
# The frontend needs no settings to run locally. To point it at a separately hosted backend, put this line in
# frontend/.env.local (Vite reads that folder, not this file). Left out or empty, it uses the same origin (/api),
# which Vite proxies to port 8000 locally.
# VITE_API_URL=
